{
  "$id": "https://raw.githubusercontent.com/zjarlin/aio-platform/main/docs/plugin/schema/page-definitions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_PageDefinition",
  "type": "array",
  "$comment": "AIO Plugin JSON contract aio:plugin@1.0.0",
  "items": {
    "$ref": "#/$defs/PageDefinition"
  },
  "$defs": {
    "PageActionDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "PageBody": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "button": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "counter"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "button"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "text"
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PageActionDefinition"
              }
            },
            "content": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "actions"
            },
            "state": {
              "type": "object",
              "additionalProperties": true,
              "default": {}
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "title",
            "content",
            "actions"
          ]
        }
      ]
    },
    "PageDefinition": {
      "type": "object",
      "properties": {
        "body": {
          "$ref": "#/$defs/PageBody"
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "required_permission": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "scene": {
          "$ref": "#/$defs/SceneDefinition"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "scene",
        "body"
      ]
    },
    "SceneDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    }
  }
}
